# Copy to .env and adjust. .env is git-ignored. These are LOCAL DEVELOPMENT values only.

# PostgreSQL (authoritative store). 15432 avoids clashing with a native PostgreSQL on 5432.
POSTGRES_DB=reviewpulse
POSTGRES_USER=reviewpulse
POSTGRES_PASSWORD=reviewpulse-local-only
POSTGRES_PORT=15432

# Kafka (host listener)
KAFKA_PORT=9092

# Redis (optional cache)
REDIS_PORT=6379

# Admin endpoints (/api/admin/**) require this header value: X-Admin-Token.
# The backend refuses to start admin endpoints with an empty token.
REVIEWPULSE_ADMIN_TOKEN=change-me-local-dev-token
